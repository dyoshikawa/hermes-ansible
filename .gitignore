.venv/
__pycache__/
*.retry
# This repository is public: real inventories carry hostnames and vault files,
# so only the *.example.yml files are tracked.
/inventory/*
!/inventory/*.example.yml
!/inventory/group_vars/
/inventory/group_vars/*/*
!/inventory/group_vars/*/vars.yml
!/inventory/group_vars/*/*.example.yml
.vault-password
*.vault-pass*

