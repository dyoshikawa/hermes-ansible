#!/bin/sh
# Managed by Ansible (hermes_agent role); local edits are overwritten.
# Runs Hermes Agent as {{ hermes_agent_user }}. The launcher lives in a tree that
# account can write to, so it must never run with anyone else's privileges.
set -eu
launcher={{ hermes_agent_launcher | quote }}
service_user={{ hermes_agent_user | quote }}
service_home={{ hermes_agent_home | quote }}
hermes_home={{ hermes_agent_hermes_home | quote }}

case "$(id -un)" in
  "$service_user")
    exec "$launcher" "$@"
    ;;
  root)
    # --pty: do not hand root's terminal to the service account (TIOCSTI).
    # env -i: do not leak root's environment (SUDO_USER, SSH_AUTH_SOCK, ...).
    pty=
    if [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; then pty=--pty; fi
    exec runuser $pty -u "$service_user" -- env -i \
      HOME="$service_home" USER="$service_user" LOGNAME="$service_user" \
      HERMES_HOME="$hermes_home" PATH=/usr/local/bin:/usr/bin:/bin \
      TERM="${TERM:-dumb}" LANG="${LANG:-C.UTF-8}" \
      "$launcher" "$@"
    ;;
  *)
    exec sudo -u "$service_user" -H env HERMES_HOME="$hermes_home" "$launcher" "$@"
    ;;
esac
